# External paths and device settings. Override any value before running a script.
_PIPELINE_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export TTS_ROOT="${TTS_ROOT:-$_PIPELINE_ENV_DIR}"
export LLAMA_OMNI_DIR="${LLAMA_OMNI_DIR:-/path/to/llama.cpp-omni}"
export CPP_BIN="${CPP_BIN:-$LLAMA_OMNI_DIR/build/bin/llama-omni-tts-eval}"
export CPP_BUILD_LIB="${CPP_BUILD_LIB:-$(dirname "$CPP_BIN")}" 
export CUDA_RUNTIME_LIB="${CUDA_RUNTIME_LIB:-}"
export MODEL_PATH="${MODEL_PATH:-/path/to/MiniCPM-o-4_5-gguf}"
export TTS_MODEL_PATH="${TTS_MODEL_PATH:-$MODEL_PATH/tts/MiniCPM-o-4_5-tts-F16.gguf}"
export ONNX_MODEL_DIR="${ONNX_MODEL_DIR:-/path/to/Step-Audio-2-mini/token2wav}"
export EVAL_DATA_PATH="${EVAL_DATA_PATH:-/path/to/seedtts_testset_zh/zh}"
export EVAL_META_PATH="${EVAL_META_PATH:-$EVAL_DATA_PATH/meta.lst}"
export PARAFORMER_MODEL="${PARAFORMER_MODEL:-/path/to/paraformer-zh}"
export SPEAKER_CKPT="${SPEAKER_CKPT:-/path/to/wavlm_large_finetune.pth}"
export S3PRL_REPO="${S3PRL_REPO:-/path/to/s3prl}"
export TTS_DEVICE="${TTS_DEVICE:-cpu}"
export T2W_DEVICE="${T2W_DEVICE:-cpu}"
export CPP_NGL="${CPP_NGL:-0}"
export WER_DEVICE="${WER_DEVICE:-cpu}"
export SIM_DEVICE="${SIM_DEVICE:-cpu}"
